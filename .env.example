DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=bot_application_id
DISCORD_CLIENT_SECRET=your_oauth2_client_secret
# Optional when registering commands per guild
DISCORD_GUILD_ID=your_testing_guild_id

# Opcja A: pojedynczy node
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Spotify Developer credentials (required only for Spotify links)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Opcja B: wiele node (JSON)
# LAVALINK_NODES=[{"id":"main","host":"127.0.0.1","port":2333,"password":"youshallnotpass","secure":false}]

DEFAULT_SOURCE=ytsearch
IDLE_TIMEOUT_MS=300000
# Optional: error, warn, info, debug
AUTOPLAY_LOG_LEVEL=warn

# Optional private deployment mode. Empty allowlist denies every guild.
GUILD_ACCESS_MODE=public
ALLOWED_GUILD_IDS=
PRIVATE_ACCESS_CONTACT=aleksh8

# Web Dashboard
WEB_PORT=3001
WEB_HOST=0.0.0.0
WEB_URL=http://localhost:3000
SESSION_SECRET=random-secret-change-this

# Next.js (only needed for dev)
# NEXT_PUBLIC_API_URL=http://localhost:3001
