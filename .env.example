DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=bot_application_id
DISCORD_CLIENT_SECRET=your_oauth2_client_secret
# Optional legacy guild ID to clean when switching from guild-scoped commands.
DISCORD_GUILD_ID=your_old_testing_guild_id
# Optional comma-separated legacy guild IDs to clean after switching to global commands.
COMMAND_GUILD_IDS=
COMMAND_CLEANUP_GUILD_IDS=

# Opcja A: pojedynczy node
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=replace-with-a-long-random-password
LAVALINK_SECURE=false

# Spotify Developer credentials (required only for Spotify links)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Opcja B: wiele node (JSON)
# LAVALINK_NODES=[{"id":"main","host":"127.0.0.1","port":2333,"password":"youshallnotpass","secure":false}]

DEFAULT_SOURCE=ytsearch
IDLE_TIMEOUT_MS=300000
# Global quota for all local audio uploads on this installation.
UPLOAD_STORAGE_LIMIT_MB=1024
# Optional: error, warn, info, debug
AUTOPLAY_LOG_LEVEL=warn
# Optional AI discovery planner and reranker. Without a valid key, autoplay uses the local algorithm only.
GEMINI_AUTOPLAY_ENABLED=true
GEMINI_API_KEY=
GEMINI_AUTOPLAY_MODEL=gemini-3.5-flash-lite
GEMINI_AUTOPLAY_TIMEOUT_MS=6000
GEMINI_AUTOPLAY_MAX_CANDIDATES=24

# Optional private deployment mode. Empty allowlist denies every guild.
GUILD_ACCESS_MODE=public
ALLOWED_GUILD_IDS=
PRIVATE_ACCESS_CONTACT=aleksh8

# Web Dashboard
WEB_PORT=3001
WEB_HOST=0.0.0.0
WEB_URL=http://localhost:3000

# Discord Activity. Set to false to hide the in-Discord player while keeping the bot online.
ACTIVITY_ENABLED=true
# Optional application emoji IDs: name:id,name:id
PLAYER_EMOJI_IDS=
SESSION_SECRET=random-secret-change-this

# Next.js (only needed for dev)
# NEXT_PUBLIC_API_URL=http://localhost:3001
